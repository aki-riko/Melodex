{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "lyrics-bridge",
  "description": "桌面歌词壳内直连：允许主窗口的站点页面把播放状态推给本机歌词窗、回传控制命令，并读写本机歌词设置（设置页与旧 PrismQML 实现一样放在主窗口设置页）。不涉及文件/网络/系统能力。",
  "windows": ["main"],
  "permissions": [
    "allow-lyrics-push-state",
    "allow-lyrics-send-command",
    "allow-lyrics-settings-get",
    "allow-lyrics-settings-update",
    "allow-lyrics-reset-position"
  ],
  "remote": {
    "urls": [
      "https://music.9li.life/*",
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  }
}
