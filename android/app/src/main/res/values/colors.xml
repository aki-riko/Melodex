<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fluent 浅色(默认)。与前端 fluent-light 的页面底色 #F3F3F3 对齐。

         为什么这几个色值重要:APK 的 windowBackground 决定 WebView 里
         prefers-color-scheme 的初判。此前这里写死 #181818(暗色)且没有
         values-night 变体,结果系统处于浅色时 WebView 仍报 dark,
         「跟随系统」永远解析成深色 —— 这是一个只在真机上才暴露的坑。

         注意:XML 注释里不能出现连续两个减号(那是非法字符),
         所以这里不要写 CSS 变量名。 -->
    <color name="melodex_background">#F3F3F3</color>
    <color name="melodex_surface">#FAFAFA</color>
    <color name="melodex_accent">#004F99</color>
    <color name="melodex_text">#111111</color>
    <color name="melodex_text_secondary">#666666</color>
</resources>
