<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色档(AppCompat.DayNight 在系统浅色时选中)。
         状态栏/导航栏图标必须是深色,因为底色是浅的 ——
         此前这里不分深浅写死 windowLightStatusBar=false,
         导致浅色底上出现白色状态栏图标(几乎看不见)。

         关于 windowLightNavigationBar:它要求 API 27,而本应用 minSdk 是 26。
         因此拆到 values-v27/ 里单独声明,不在基础档引用 —— 否则 lint 的
         NewApi 检查会直接判定构建失败(实测踩到)。 -->
    <style name="Theme.Melodex" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/melodex_background</item>
        <item name="android:colorAccent">@color/melodex_accent</item>
        <item name="android:navigationBarColor">@color/melodex_background</item>
        <item name="android:statusBarColor">@color/melodex_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
