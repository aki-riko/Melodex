<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色 + API 27 及以上:导航栏图标保持浅色(与深底对比)。
         注意本目录是 values-night-v27,要让 DayNight 同时匹配
         「夜间」与「API 27+」两个限定符。 -->
    <style name="Theme.Melodex" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/melodex_background</item>
        <item name="android:colorAccent">@color/melodex_accent</item>
        <item name="android:navigationBarColor">@color/melodex_background</item>
        <item name="android:statusBarColor">@color/melodex_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
